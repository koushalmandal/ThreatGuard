PORT=5000
API_HOST=0.0.0.0
# Replace the sample LAN IP with the current IPv4 address shown by `ipconfig`.
CLIENT_ORIGIN=http://localhost:5173,http://192.168.1.104:5173

# Replace these placeholders with the Atlas Drivers URI. Keep the password URL-encoded.
MONGODB_URI=mongodb+srv://<ATLAS_USERNAME>:<URL_ENCODED_PASSWORD>@cluster0.wmlp8on.mongodb.net/threatguard?retryWrites=true&w=majority

# Some Windows DNS resolvers fail Atlas SRV lookups; configure a working resolver as needed.
MONGODB_DNS_SERVERS=8.8.8.8

# Maximum accepted PDF upload size in megabytes.
UPLOAD_MAX_MB=10
